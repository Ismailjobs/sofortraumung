# Lokal: .env.local | Server: gleichen Inhalt als .env (neben docker-compose.yml)
# Nicht in Git committen.

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Für Docker/Cloudflare: RECAPTCHA_SITE_KEY reicht (Runtime, kein Rebuild nötig)
RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
# Tunnel-Domain hier eintragen, z. B. app.example.com
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,sofortraumung.at,www.sofortraumung.at

# Brevo – E-Mail-Versand (https://app.brevo.com)
BREVO_API_KEY=
# Absender & Kunden-Antwort: nur sofortraumung.at (für Kunden sichtbar)
BREVO_SENDER_EMAIL=office@sofortraumung.at
BREVO_SENDER_NAME=SofortRäumung
# Internes Postfach: detaillierte Formular-Anfragen (nicht an Kunden)
CONTACT_TO_EMAIL=office@sofortentrumpelung.at
